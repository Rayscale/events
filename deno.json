{
  "name": "@rayscale/events",
  "description": "Lightweight, type-safe, and framework-agnostic event dispatcher and reactive state management library.",
  "version": "1.0.0",
  "exports": "./source/index.ts",
  "publish": {
    "include": [
      "source/**/*.ts",
      "deno.json",
      "README.md",
      "LICENSE"
    ]
  },
  "minimumDependencyAge": "0",
  "compilerOptions": {
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "strict": true
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 80,
    "indentWidth": 2,
    "semiColons": false,
    "singleQuote": true,
    "proseWrap": "always"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"],
      "include": [
        "ban-untagged-todo",
        "explicit-function-return-type",
        "explicit-module-boundary-types",
        "no-inferrable-types"
      ],
      "exclude": ["require-await", "no-this-alias"]
    },
    "include": ["source/", "tests/"],
    "exclude": ["playground", "coverage/"]
  },
  "tasks": {
    "quality-check": "deno fmt --check && deno lint && deno check && deno test"
  },
  "imports": {
    "@rayscale/types": "jsr:@rayscale/types@^1.0.2",
    "@std/assert": "jsr:@std/assert@^1.0.19"
  }
}
